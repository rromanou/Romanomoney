{
  "manifest_version": 3,
  "name": "Romanomoney",
  "version": "1.2.0",
  "description": "Romanomoney : jeu de clics avec surclics, rebirth, mini-jeux, casino et styles.",
  "key": "",
  "action": {
    "default_title": "Romanomoney",
    "default_popup": "popup.html",
